# HospitalCare AI — example configuration. Copy to .env (git-ignored) and change values.
# All patient data in this prototype is SYNTHETIC.

# Required: random secret used to sign agent delegation tokens.
# Generate one with:  uv run --directory backend python -c "import secrets; print(secrets.token_urlsafe(48))"
HCAI_SECRET_KEY=CHANGE_ME

# Password assigned to the seeded synthetic demo accounts (nurse.demo, clinician.demo, ...).
HCAI_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# Paths (relative to the repository root)
HCAI_DATA_DIR=data
HCAI_REFERENCE_DIR=reference

# Demo mode allows evaluation with protocols whose status is "synthetic_demo".
HCAI_DEMO_MODE=true
HCAI_FACILITY_CODE=SYNTHETIC-FACILITY-01

# Local model (Ollama). Must be a loopback address so patient content stays on this machine.
HCAI_OLLAMA_URL=http://127.0.0.1:11434
HCAI_OLLAMA_MODEL=phi4-mini
HCAI_OLLAMA_TIMEOUT_SECONDS=180
HCAI_LLM_ENABLED=true

# Original MCP server transport used by the agent: stdio (subprocess) or inprocess
HCAI_MCP_TRANSPORT=stdio

# Borrowed Filesystem MCP server (Node >= 24)
HCAI_NODE_EXECUTABLE=node
HCAI_FILESYSTEM_MCP_ENTRY=mcp-filesystem/node_modules/@modelcontextprotocol/server-filesystem/dist/index.js

# Sessions and workflow
HCAI_SESSION_TTL_MINUTES=480
HCAI_DELEGATION_TTL_MINUTES=15
HCAI_RECURRENCE_LOOKBACK_DAYS=365

# API server
HCAI_API_HOST=127.0.0.1
HCAI_API_PORT=8000
HCAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
